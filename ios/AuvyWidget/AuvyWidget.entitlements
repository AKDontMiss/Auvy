<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Group the app and its widget share. Xcode registers it for the
     development team when it signs a build. The published IPA carries no
     signature from that team, so tool/package_sideload_ipa.sh signs each bundle
     ad hoc with this file; SideStore reads it from there, registers the group
     for the installing Apple ID renamed with that team's id, and AuvyAppGroup
     finds the renamed group at run time. No team id belongs in here. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.auvy.app</string>
	</array>
</dict>
</plist>
