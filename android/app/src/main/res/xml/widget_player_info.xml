<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: the widget is pushed from the app on every
     track/like/play change — no polling. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:maxResizeHeight="120dp"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_player_desc"
    android:previewLayout="@layout/widget_player"
    android:initialLayout="@layout/widget_player" />
