<?xml version="1.0" encoding="utf-8"?>
<!-- The widgets' progress bar: a faint track and a rounded fill. The fill takes
     the accent at render time on Android 12+ (setProgressTintList); before that
     it stays the brand blue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FF53B1E1" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
