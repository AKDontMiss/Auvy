<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget's card. Opaque, so the cover tint (setColorFilter at
     render time, SRC_ATOP) replaces this colour exactly; #17171C is the app's
     sheet colour, shown when there is no cover to tint from. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF17171C" />
    <corners android:radius="26dp" />
</shape>
