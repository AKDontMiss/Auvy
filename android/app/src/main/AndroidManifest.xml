<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.auvy.app">
    
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Lets Auvy ask to be exempted from battery optimization. Some devices
         (e.g. Samsung/One UI "put app to sleep") otherwise cut the network with the
         screen off, even for a mediaPlayback foreground service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Song recognition: record microphone audio to fingerprint what's playing.
         Also required for AudioPlaybackCapture (this-device audio), which reads
         through AudioRecord too. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Audio capture for song recognition. The quick-settings tile records from
         the microphone: starting a microphone-typed foreground service on API 34+
         requires FOREGROUND_SERVICE_MICROPHONE (without it startForeground throws a
         SecurityException). The in-app capture uses MediaProjection, which is only
         granted to a running mediaProjection-typed foreground service on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    
    <!-- maxSdkVersion 32: from API 33 storage read access is split per media type,
         and READ_MEDIA_AUDIO below is the one Auvy needs. The cap stops Android 13+
         from asking for whole-storage access the app doesn't use. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- No MANAGE_EXTERNAL_STORAGE ("All files access"). It isn't needed:
         MainActivity's "listAudioIn" channel lists audio in /Music/Auvy through
         MediaStore (by RELATIVE_PATH) with READ_MEDIA_AUDIO alone. Play restricts
         the permission and malware scanners flag it, so don't re-add it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- Wake-up alarm (music instead of a ringtone). USE_EXACT_ALARM is the
         alarm-clock case Google grants without a prompt; SCHEDULE_EXACT_ALARM
         covers Android 12, where the user may have to allow it in Settings.
         RECEIVE_BOOT_COMPLETED re-arms the alarm after a reboot, since Android drops
         every alarm on restart. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- A background BroadcastReceiver can't startActivity() on Android 10+, so
         the alarm screen is shown through a full-screen-intent notification, which
         also works over the lockscreen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    
    <application
        android:label="Auvy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup">
        <!-- Android Auto browsing. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>

        <!-- The MediaBrowserService intent-filter below enables Android Auto, but it
             also opts the app into Android 11+ media resumption, which can leave a
             "resumable" media control in quick settings that keeps coming back.
             AuvyAudioHandler.getRoot prevents that by rejecting SystemUI's `recent` root
             while serving a real tree for Android Auto's `root`. If the lingering media
             control ever returns, check that getRoot override first rather than
             removing this filter. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Home-screen player widget (artwork, prev/play/next, like). State is
             pushed from the Dart audio handler; buttons route through the media
             session's MediaButtonReceiver (transport) and the widget channel
             (like). -->
        <!-- The widget buttons. Not exported: the AppWidgetProvider has to be exported
             to receive APPWIDGET_UPDATE, and an exported receiver accepts explicit
             intents from any app, so the actions live here instead. The widget's own
             PendingIntents can still reach it. -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".PlayerWidgetProvider"
            android:label="@string/widget_player_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>
        
        <!-- Audio capture for song recognition. Not exported: only Auvy starts it. -->
        <!-- Two types because it captures two ways: `microphone` for the tile and
             `mediaProjection` for the in-app this-device capture. The type passed to
             startForeground must be declared here. -->
        <service
            android:name=".AudioCaptureService"
            android:foregroundServiceType="microphone|mediaProjection"
            android:exported="false" />


        <!-- Invisible activity that starts the tile's microphone capture
             (RECORD_AUDIO needs the app in the foreground). Translucent and
             excluded from recents. -->
        <activity
            android:name=".TileCaptureActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />

        <!-- Quick-settings tile: identify what is playing in another app without
             leaving it. The "hold home for assistant" gesture is reserved for the
             default assistant app, so a tile is the equivalent. See RecognizeTileService. -->
        <service
            android:name=".RecognizeTileService"
            android:label="Identify song"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Plays the wake-up alarm itself, so the music doesn't wait for anyone to tap
             a notification. Not exported: only AlarmReceiver and its own notification
             actions start it. -->
        <service
            android:name=".AlarmAudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- What's New: the check with Auvy closed (JobScheduler, twice a day on a
             network). Only the system may bind it. -->
        <service
            android:name=".WhatsNewJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Wake-up alarm receiver. Not exported: AlarmManager and the system's
             BOOT_COMPLETED broadcast reach it without that, and exporting it would let
             any app fire the alarm. -->
        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.auvy.app.ALARM" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- singleTask, not singleTop, because of the icon aliases. The launcher opens
             whichever alias is enabled (.MainActivityRed / Green / Default, see
             AlternateIconManager), while the media notification, the QS tile and
             AudioCaptureService target .MainActivity directly. Under singleTop those
             land in different tasks, so the app would run twice (two activities, two
             Flutter engines), and the visible one could end up with a dead player
             channel.

             singleTask guarantees one instance in one task whichever component was
             launched; repeat launches arrive through onNewIntent, which already reads
             the found-song, alarm and mic extras. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <!-- No launcher intent-filter here, deliberately. MainActivity is the
                 targetActivity of every icon alias below, so it must always stay enabled;
                 the default icon is the `.MainActivityDefault` alias instead. -->
        </activity>

        <!-- LAUNCHER ICONS (Settings → Appearance → App icon)
             Every launcher entry is an alias pointing at MainActivity, each with its own
             icon. Exactly one should be enabled: two shows the app twice, zero hides it.
             `.MainActivityDefault` ships enabled; the colours ship disabled.
             AlternateIconManager enables the chosen one and disables the others.
             android:exported="true" is required on API 31+ for anything with an
             intent-filter. targetActivity must be the fully-qualified name. -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityGreen"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_green"
            android:roundIcon="@mipmap/ic_launcher_green"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityOrange"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:roundIcon="@mipmap/ic_launcher_orange"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPink"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pink"
            android:roundIcon="@mipmap/ic_launcher_pink"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPurple"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityRed"
            android:targetActivity="com.auvy.app.MainActivity"
            android:theme="@style/LaunchTheme"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:label="Auvy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Native YouTube sign-in screen (a plain WebView; the Flutter plugin WebView
             kept tripping Google's "browser may not be secure" check). -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/NormalTheme" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>

        <!-- The phone's own file manager, by name. From Android 11 an app can't see
             another package unless it's declared here, so MainActivity.openFolder and
             pickFile could never resolve Samsung My Files without this. Other phones
             fall back to Google's DocumentsUI. -->
        <package android:name="com.sec.android.app.myfiles" />
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>