# Copy to .env and fill in. tool/build_release.ps1 (Android) and
# tool/build_ios.sh (iOS) pass every line to the build as --dart-define.
# .env itself is gitignored and never bundled into the app.

# Host of your own backend (the auth Worker; not part of this repository).
AUVY_WORKER_HOST=your-worker.your-account.workers.dev

# Optional: Spotify Web API client id for the playlist-import fallback.
# Never put a secret here: every value is compiled into the app and readable
# inside it, and the build scripts refuse names that look like secrets.
# SPOTIFY_CLIENT_ID=
